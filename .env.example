# reqhq v2 optional environment configuration
# Copy this file to `.env` (gitignored) and populate only the values you need.
# All core Phase 1 workflows and unit tests run 100% offline without any API keys.

# --- Cloud LLM Fallback Providers (Optional; disabled when REQHQ_STRICT_LOCAL=true) ---
# Google Gemini API key for Tier 1/2/3 cloud escalation when local Ollama is insufficient
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API key for fast cloud fallback inference
GROQ_API_KEY=your-groq-api-key-here

# --- Local Inference & Hardware Routing ---
# Base URL for local Ollama server
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Set to true/1 to hard-block all outbound cloud LLM calls (strict local-only mode)
REQHQ_STRICT_LOCAL=false

# Optional integer override (0, 1, 2, or 3) to force a specific HardwareTier
# Leave blank or unset for automatic hardware profiling
REQHQ_HARDWARE_TIER=

# Optional storage and quota overrides (defaults shown)
# REQHQ_SESSIONS_DIR=.reqhq_sessions
# REQHQ_ADR_DIR=docs/adr
# REQHQ_QUOTA_CEILING_RATIO=0.90
# REQHQ_QUOTA_DB_PATH=.reqhq_sessions/quota_ledger.db
# REQHQ_CACHE_DB_PATH=.reqhq_sessions/prompt_cache.db

# --- Enterprise Document Connectors (Optional; OAuth2 / MSAL) ---
# Path to Google OAuth2 desktop client secrets JSON (never commit credentials.json)
GOOGLE_OAUTH_CLIENT_SECRETS=path/to/credentials.json

# Microsoft Entra ID (Azure AD) application client ID for SharePoint/OneDrive MSAL device-code flow
MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Microsoft Entra ID tenant ID (or "common" / "organizations")
MSAL_TENANT_ID=common
